# Export these in your shell or set them as Railway variables. The app does not load .env by itself.
# Network the platform runs on: mainnet, testnet or sandbox.
NEAR_NETWORK=testnet
# Factory account printed by npm run platform:deploy.
PAYGATE_FACTORY=
# Postgres connection. Without it, data is kept in files in DATA_DIR.
DATABASE_URL=
# Encrypts customer agent keys and NEAR AI keys. At least 32 characters; required when hosted. Back it up.
PAYGATE_SECRET=
# Public https address of the deployment. Railway sets RAILWAY_PUBLIC_DOMAIN, which works too.
PUBLIC_URL=
# Optional RPC endpoint and model.
NEAR_RPC_URL=
NEAR_AI_MODEL=qwen/qwen3.5-397b-a17b
PORT=3000
# Platform deployment only, on your own machine: NEAR_OPERATOR_ACCOUNT, NEAR_OPERATOR_KEY, FACTORY_NAME, FACTORY_FUND.
