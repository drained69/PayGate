# Export these in your shell or set them as Railway variables. The app does not load .env by itself.
# Required when the app is reachable from the internet (PUBLIC_URL set). At least 12 characters.
PAYGATE_PASSWORD=
# Public https address of the deployment. Railway sets RAILWAY_PUBLIC_DOMAIN, which works too.
PUBLIC_URL=
# Where the workspace is saved. On Railway, a volume mount path such as /data.
DATA_DIR=
# Vault settings written by npm run vault:deploy (data/chain.json). They include the agent's restricted key: keep them private.
PAYGATE_CHAIN_JSON=
# Optional. Lets the agent do the work on NEAR AI Cloud.
NEAR_AI_API_KEY=
NEAR_AI_MODEL=qwen/qwen3.5-397b-a17b
PORT=3000
# Never set NEAR_OWNER_KEY on a server. It is used only by npm run vault:deploy on your own machine.
